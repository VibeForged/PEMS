# Copy this file to .env and replace the example values.
# Keep the datasource URL unchanged for MySQL on localhost:3306.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pems_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_base64_secret_at_least_32_bytes_long
